<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.npc.common.todo.mapper.TodoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.npc.common.todo.entity.Todo">
            <result column="id" property="id"/>
            <result column="todo_name" property="todoName"/>
            <result column="type" property="type"/>
            <result column="tag" property="tag"/>
            <result column="remark" property="remark"/>
            <result column="status" property="status"/>
            <result column="quartz_id" property="quartzId"/>
            <result column="plan_id" property="planId"/>
            <result column="problem_id" property="problemId"/>
            <result column="start_time" property="startTime"/>
            <result column="end_time" property="endTime"/>
            <result column="remind" property="remind"/>
            <result column="remind_type" property="remindType"/>
            <result column="remind_week" property="remindWeek"/>
            <result column="remind_day" property="remindDay"/>
            <result column="remind_lunar_day" property="remindLunarDay"/>
            <result column="remind_time" property="remindTime"/>
            <result column="remind_todo" property="remindTodo"/>
            <result column="done_score" property="doneScore"/>
            <result column="done_get" property="doneGet"/>
            <result column="recurrence_type" property="recurrenceType"/>
            <result column="recurrence_params" property="recurrenceParams"/>
            <result column="recurrence_interval" property="recurrenceInterval"/>
            <result column="next_due_date" property="nextDueDate"/>
    </resultMap>
    <resultMap id="BaseVOResultMap" type="com.npc.common.todo.vo.TodoViewVO">
            <result column="id" property="id"/>
            <result column="todo_name" property="todoName"/>
            <result column="type" property="type"/>
            <result column="tag" property="tag"/>
            <result column="remark" property="remark"/>
            <result column="status" property="status"/>
            <result column="quartz_id" property="quartzId"/>
            <result column="plan_id" property="planId"/>
            <result column="problem_id" property="problemId"/>
            <result column="start_time" property="startTime"/>
            <result column="end_time" property="endTime"/>
            <result column="remind" property="remind"/>
            <result column="remind_type" property="remindType"/>
            <result column="remind_week" property="remindWeek"/>
            <result column="remind_day" property="remindDay"/>
            <result column="remind_time" property="remindTime"/>
            <result column="remind_lunar_day" property="remindLunarDay"/>
            <result column="remind_todo" property="remindTodo"/>
            <result column="done_score" property="doneScore"/>
            <result column="done_get" property="doneGet"/>
            <result column="recurrence_type" property="recurrenceType"/>
            <result column="recurrence_days" property="recurrenceDays"/>
            <result column="recurrence_interval" property="recurrenceInterval"/>
            <result column="next_due_date" property="nextDueDate"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
            id, todo_name, type, tag, remark, status, quartz_id, plan_id, problem_id, start_time, end_time, remind, remind_type, remind_week, remind_day, remind_time, remind_lunar_day, remind_todo, done_score, done_get, recurrence_type, recurrence_params, next_due_date
    </sql>
    <sql id="Prefixed_Base_Column_List">
        td.id, td.todo_name, td.type, td.tag, td.remark, td.status, td.quartz_id, td.plan_id, td.problem_id, td.start_time, td.end_time, td.remind, td.remind_type, td.remind_week, td.remind_day, td.remind_time, td.remind_lunar_day, td.remind_todo, td.done_score, td.done_get, td.recurrence_type, td.recurrence_params, td.next_due_date
    </sql>


    <sql id="commonConditionSQL">
        <where>
            t_todo.is_delete = 0
                <if test="id != '' and id != null">
                    and t_todo.id = #{id}
                </if>
                <if test="todoName != '' and todoName != null">
                    and t_todo.todo_name = #{todoName}
                </if>
                <if test="type != '' and type != null">
                    and t_todo.type = #{type}
                </if>
                <if test="tag != '' and tag != null">
                    and t_todo.tag = #{tag}
                </if>
                <if test="remark != '' and remark != null">
                    and t_todo.remark = #{remark}
                </if>
                <if test="status != '' and status != null">
                    and t_todo.status = #{status}
                </if>
                <if test="quartzId != '' and quartzId != null">
                    and t_todo.quartz_id = #{quartzId}
                </if>
                <if test="planId != '' and planId != null">
                    and t_todo.plan_id = #{planId}
                </if>
                <if test="problemId != '' and problemId != null">
                    and t_todo.problem_id = #{problemId}
                </if>
                <if test="startTime != '' and startTime != null">
                    and t_todo.start_time = #{startTime}
                </if>
                <if test="endTime != '' and endTime != null">
                    and t_todo.end_time = #{endTime}
                </if>
                <if test="remind != '' and remind != null">
                    and t_todo.remind = #{remind}
                </if>
                <if test="remindType != '' and remindType != null">
                    and t_todo.remind_type = #{remindType}
                </if>
                <if test="remindWeek != '' and remindWeek != null">
                    and t_todo.remind_week = #{remindWeek}
                </if>
                <if test="remindDay != '' and remindDay != null">
                    and t_todo.remind_day = #{remindDay}
                </if>
                <if test="remindLunarDay != '' and remindLunarDay != null">
                    and t_todo.remind_lunar_day = #{remindLunarDay}
                </if>
                <if test="remindTime != '' and remindTime != null">
                    and t_todo.remind_time = #{remindTime}
                </if>
                <if test="remindTodo != '' and remindTodo != null">
                    and t_todo.remind_todo = #{remindTodo}
                </if>
                <if test="doneScore != '' and doneScore != null">
                    and t_todo.done_score = #{doneScore}
                </if>
                <if test="doneGet != '' and doneGet != null">
                    and t_todo.done_get = #{doneGet}
                </if>
                <if test="recurrenceType != '' and recurrenceType != null">
                    and t_todo.recurrence_type = #{recurrenceType}
                </if>
                <if test="recurrenceParams != '' and recurrenceParams != null">
                    and t_todo.recurrence_params = #{recurrenceParams}
                </if>
                <if test="nextDueDate != '' and nextDueDate != null">
                    and t_todo.next_due_date = #{nextDueDate}
                </if>
        </where>
    </sql>

    <select id="getTodoListByColList" resultType="com.npc.common.todo.entity.Todo">
        select
        <include refid="Base_Column_List"/>
        from t_todo
        <where>
            t_todo.is_delete = 0
            and ${column} in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                ${id}
            </foreach>
        </where>
    </select>
    <select id="getList" resultMap="BaseVOResultMap">
        select plan.content,
        <include refid="Prefixed_Base_Column_List"/>
        from t_todo td
        LEFT JOIN t_plan plan on td.plan_id = plan.id
        <where>
            <if test="vo.startDate != null and vo.startDate != ''">
                and td.start_time &lt; #{vo.startDate}
            </if>
            <if test="vo.endDate != null and vo.endDate != ''">
                and td.end_time > #{vo.endDate}
            </if>
            <if test="vo.type != null and vo.type != ''">
                and td.type = #{vo.type}
            </if>
            <if test="vo.id != null and vo.id != ''">
                and td.id = #{vo.id}
            </if>
        </where>
    </select>

</mapper>
