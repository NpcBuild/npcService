<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.npc.common.modular.career.mapper.SolutionProjectMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.npc.common.modular.career.entity.SolutionProject">
            <result column="id" property="id"/>
            <result column="title" property="title"/>
            <result column="description" property="description"/>
            <result column="linked_problem_id" property="linkedProblemId"/>
            <result column="stage" property="stage"/>
            <result column="impact_score" property="impactScore"/>
            <result column="effort_score" property="effortScore"/>
            <result column="feasibility" property="feasibility"/>
            <result column="traction" property="traction"/>
            <result column="next_action" property="nextAction"/>
            <result column="tags" property="tags"/>
            <result column="favorite" property="favorite"/>
            <result column="created_at" property="createdAt"/>
            <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
            id, title, description, linked_problem_id, stage, impact_score, effort_score, feasibility, traction, next_action, tags, favorite, created_at, updated_at
    </sql>

    <sql id="commonConditionSQL">
        <where>
            t_solution_project.is_delete = 0
                <if test="id != '' and id != null">
                    and t_solution_project.id = #{id}
                </if>
                <if test="title != '' and title != null">
                    and t_solution_project.title = #{title}
                </if>
                <if test="description != '' and description != null">
                    and t_solution_project.description = #{description}
                </if>
                <if test="linkedProblemId != '' and linkedProblemId != null">
                    and t_solution_project.linked_problem_id = #{linkedProblemId}
                </if>
                <if test="stage != '' and stage != null">
                    and t_solution_project.stage = #{stage}
                </if>
                <if test="impactScore != '' and impactScore != null">
                    and t_solution_project.impact_score = #{impactScore}
                </if>
                <if test="effortScore != '' and effortScore != null">
                    and t_solution_project.effort_score = #{effortScore}
                </if>
                <if test="feasibility != '' and feasibility != null">
                    and t_solution_project.feasibility = #{feasibility}
                </if>
                <if test="traction != '' and traction != null">
                    and t_solution_project.traction = #{traction}
                </if>
                <if test="nextAction != '' and nextAction != null">
                    and t_solution_project.next_action = #{nextAction}
                </if>
                <if test="tags != '' and tags != null">
                    and t_solution_project.tags = #{tags}
                </if>
                <if test="favorite != '' and favorite != null">
                    and t_solution_project.favorite = #{favorite}
                </if>
                <if test="createdAt != '' and createdAt != null">
                    and t_solution_project.created_at = #{createdAt}
                </if>
                <if test="updatedAt != '' and updatedAt != null">
                    and t_solution_project.updated_at = #{updatedAt}
                </if>
        </where>
    </sql>

    <select id="getSolutionProjectListByColList" resultType="com.npc.common.modular.career.entity.SolutionProject">
        select
        <include refid="Base_Column_List"/>
        from t_solution_project
        <where>
            t_solution_project.is_delete = 0
            and ${column} in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                ${id}
            </foreach>
        </where>
    </select>

</mapper>
