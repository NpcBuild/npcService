<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.npc.common.modular.money.mapper.MoneyPointMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.npc.common.modular.money.entity.MoneyPoint">
            <result column="id" property="id"/>
            <result column="user_id" property="userId"/>
            <result column="date_time" property="dateTime"/>
            <result column="money" property="money"/>
            <result column="type" property="type"/>
            <result column="assets" property="assets"/>
            <result column="debt" property="debt"/>
            <result column="status" property="status"/>
            <result column="created_at" property="createdAt"/>
            <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
            id, user_id, date_time, money, type, assets, debt, status, created_at, updated_at
    </sql>

    <sql id="commonConditionSQL">
        <where>
            t_money_point.is_delete = 0
                <if test="id != '' and id != null">
                    and t_money_point.id = #{id}
                </if>
                <if test="userId != '' and userId != null">
                    and t_money_point.user_id = #{userId}
                </if>
                <if test="dateTime != '' and dateTime != null">
                    and t_money_point.date_time = #{dateTime}
                </if>
                <if test="money != '' and money != null">
                    and t_money_point.money = #{money}
                </if>
                <if test="type != '' and type != null">
                    and t_money_point.type = #{type}
                </if>
                <if test="assets != '' and assets != null">
                    and t_money_point.assets = #{assets}
                </if>
                <if test="debt != '' and debt != null">
                    and t_money_point.debt = #{debt}
                </if>
                <if test="status != '' and status != null">
                    and t_money_point.status = #{status}
                </if>
                <if test="createdAt != '' and createdAt != null">
                    and t_money_point.created_at = #{createdAt}
                </if>
                <if test="updatedAt != '' and updatedAt != null">
                    and t_money_point.updated_at = #{updatedAt}
                </if>
        </where>
    </sql>

    <select id="getMoneyPointListByColList" resultType="com.npc.common.modular.money.entity.MoneyPoint">
        select
        <include refid="Base_Column_List"/>
        from t_money_point
        <where>
            t_money_point.is_delete = 0
            and ${column} in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                ${id}
            </foreach>
        </where>
    </select>

</mapper>
