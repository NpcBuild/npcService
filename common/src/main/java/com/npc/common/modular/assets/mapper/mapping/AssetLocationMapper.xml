<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.npc.common.modular.assets.mapper.AssetLocationMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.npc.common.modular.assets.entity.AssetLocation">
            <result column="id" property="id"/>
            <result column="location_name" property="locationName"/>
            <result column="location_type" property="locationType"/>
            <result column="parent_location" property="parentLocation"/>
            <result column="detail" property="detail"/>
            <result column="temperature_zone" property="temperatureZone"/>
            <result column="notes" property="notes"/>
            <result column="created_at" property="createdAt"/>
            <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
            id, location_name, location_type, parent_location, detail, temperature_zone, notes, created_at, updated_at
    </sql>

    <sql id="commonConditionSQL">
        <where>
            t_asset_location.is_delete = 0
                <if test="id != '' and id != null">
                    and t_asset_location.id = #{id}
                </if>
                <if test="locationName != '' and locationName != null">
                    and t_asset_location.location_name = #{locationName}
                </if>
                <if test="locationType != '' and locationType != null">
                    and t_asset_location.location_type = #{locationType}
                </if>
                <if test="parentLocation != '' and parentLocation != null">
                    and t_asset_location.parent_location = #{parentLocation}
                </if>
                <if test="detail != '' and detail != null">
                    and t_asset_location.detail = #{detail}
                </if>
                <if test="temperatureZone != '' and temperatureZone != null">
                    and t_asset_location.temperature_zone = #{temperatureZone}
                </if>
                <if test="notes != '' and notes != null">
                    and t_asset_location.notes = #{notes}
                </if>
                <if test="createdAt != '' and createdAt != null">
                    and t_asset_location.created_at = #{createdAt}
                </if>
                <if test="updatedAt != '' and updatedAt != null">
                    and t_asset_location.updated_at = #{updatedAt}
                </if>
        </where>
    </sql>

    <select id="getAssetLocationListByColList" resultType="com.npc.common.modular.assets.entity.AssetLocation">
        select
        <include refid="Base_Column_List"/>
        from t_asset_location
        <where>
            t_asset_location.is_delete = 0
            and ${column} in
            <foreach collection="ids" item="id" separator="," open="(" close=")">
                ${id}
            </foreach>
        </where>
    </select>

</mapper>
